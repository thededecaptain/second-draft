{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "SecondDraft",
    "description": "Rewrite draft Slack messages in a chosen tone (Friendly, Direct, Formal) for your audience (teammate, manager, customer).",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "SecondDraft",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/draft",
        "url": "https://example.com/slack/events",
        "description": "Rewrite a draft message for tone and audience",
        "usage_hint": "[your draft text]",
        "should_escape": false
      },
      {
        "command": "/seconddraft",
        "url": "https://example.com/slack/events",
        "description": "Rewrite a draft message for tone and audience",
        "usage_hint": "[your draft text]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:3000/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.com/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
