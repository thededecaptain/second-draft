# Postgres (managed provider connection string)
DATABASE_URL="postgresql://user:password@host:5432/seconddraft?sslmode=require"

# Slack app credentials (https://api.slack.com/apps)
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=
# Socket Mode app-level token (xapp-...)
SLACK_APP_TOKEN=

# Platform LLM key for SMB tier workspaces
ANTHROPIC_API_KEY=

# Anthropic model (default if unset: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
PORT=3000
NODE_ENV=development

# Local dev envelope encryption (user OAuth tokens + phase 2 BYOK; 32-byte hex)
# Generate: openssl rand -hex 32
LOCAL_ENVELOPE_MASTER_KEY=

# Public HTTPS URL for per-user OAuth callback (ngrok/Cloudflare Tunnel in dev)
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=
