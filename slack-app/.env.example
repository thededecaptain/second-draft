# Postgres (managed provider connection string)
DATABASE_URL="postgresql://user:password@host:5432/seconddraft?sslmode=require"

# Slack app credentials (https://api.slack.com/apps)
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=

# Platform LLM key for SMB tier workspaces
ANTHROPIC_API_KEY=

# Anthropic model (default if unset: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
PORT=3000
NODE_ENV=development

# Local dev envelope encryption (user OAuth tokens + phase 2 BYOK; 32-byte hex)
# Generate: openssl rand -hex 32
LOCAL_ENVELOPE_MASTER_KEY=

# Public HTTPS base URL of this server.
# Dev: tunnel URL (cloudflared/ngrok). Prod: your deployed domain (e.g. https://second-draft-production.up.railway.app)
# Used for the per-user "send as me" OAuth callback.
PUBLIC_BASE_URL=
